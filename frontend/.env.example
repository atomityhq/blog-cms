# Copy to .env.local for `npm run dev`. Never commit real values.

# Spring Boot backend, reached server-side only (never exposed to the browser,
# so do not prefix with NEXT_PUBLIC_).
BACKEND_API_URL=http://localhost:8080

# Session cookies are Secure (HTTPS-only) in production. Browsers exempt localhost; to
# sign in over plain HTTP on any other host, set this to false.
# SESSION_COOKIE_SECURE=false
