# Backend environment. Copy to .env (or export) for non-docker runs.
# SPRING_PROFILES_ACTIVE=local supplies local DB/admin/JWT defaults only.
# Nextcloud variables below are still required for media storage.
SERVER_PORT=8080
SPRING_DATASOURCE_URL="My_DB_URL"
SPRING_DATASOURCE_USERNAME=blog_cms
SPRING_DATASOURCE_PASSWORD="My_DB_Password"

# Admin sign-in (bcrypt hash of the password — see the root README) and token signing key.
ADMIN_EMAIL="My_Email"
ADMIN_PASSWORD_HASH='Password'
JWT_SECRET=Jwt_Secret
# Session length (Spring duration format)
JWT_TTL=8h

# Nextcloud media storage (use a dedicated Nextcloud app password)
NEXTCLOUD_URL="My_NextCloud_URL"
NEXTCLOUD_USERNAME=blogcms
NEXTCLOUD_PASSWORD="My_NextCloud_Password"
NEXTCLOUD_REMOTE_DIRECTORY=/BlogCMS
