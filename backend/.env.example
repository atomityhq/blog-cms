# Backend environment. Copy to .env (or export) for non-docker runs.
# For local development you can skip this file and use SPRING_PROFILES_ACTIVE=local.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blog_crm
SPRING_DATASOURCE_USERNAME=blog_crm
SPRING_DATASOURCE_PASSWORD=change-me
